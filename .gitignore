__pycache__/
*.pyc
.DS_Store

# ephemeral v0.3.0 explorer (figures/serve_kg_v030.sh)
.kg_explorer_v030/

# corpus build caches (rebuildable: each dir's script refetches)
rahman/.cache/
gitops/.cache/

# Generated corpora are not published here. They hold third-party manifests verbatim,
# and the Rahman set contains at least one live-looking credential (a Grafana API key),
# so the files stay local; each directory's script rebuilds them.
rahman/corpora/*.jsonl
stack/corpora/*.jsonl
gitops/corpora/*.jsonl

# reasoning scratch: regenerated by src/consistency_check.py
results/merged-*.nt

# 407 MB partitioned stack ABox: rebuild with src/build_abox_partitioned.py
ontology/kcro-abox-stack.nt

# v0.4.0 ABox with provenance (33 MB, rebuild: src/instantiate_kcro.py --arrow
# data/k8s_dataset). ontology/kcro-abox.ttl stays as the defended v0.3.0 artefact.
ontology/kcro-abox-v040.ttl

# per-stage ABoxes from the v0.5.0 CRD work: rebuild with src/instantiate_kcro.py
ontology/kcro-abox-*-s1.ttl
ontology/kcro-abox-*-s3.ttl
ontology/kcro-abox-*-s2.ttl

# large v0.5.0 builds: rebuild with src/instantiate_kcro.py / src/build_abox_partitioned.py
ontology/kcro-abox-kubeobjects-v050.ttl
ontology/kcro-abox-stack-v050.nt
